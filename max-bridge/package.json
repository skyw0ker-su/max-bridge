{
  "name": "@local/max-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Мост MAX -> сессия: сообщения из мессенджера MAX попадают в диалог как пользовательские",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "certs/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
